<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oracle.test.mapper.SysRoleMapper">

    <resultMap id="BaseMap" type="com.oracle.test.entity.SysRole">
        <id     property="roleId"     column="ROLE_ID"/>
        <result property="roleName"   column="ROLE_NAME"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="isDeleted"  column="IS_DELETED"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updateTime" column="UPDATE_TIME"/>
        <result property="updateBy"   column="UPDATE_BY"/>
    </resultMap>

    <select id="listAll" resultMap="BaseMap">
        SELECT * FROM SYS_ROLE WHERE IS_DELETED = 0 ORDER BY ROLE_ID
    </select>

    <select id="findById" resultMap="BaseMap">
        SELECT * FROM SYS_ROLE WHERE ROLE_ID = #{roleId}
    </select>

    <insert id="insert" parameterType="com.oracle.test.entity.SysRole">
        <selectKey keyProperty="roleId" resultType="long" order="BEFORE">
            SELECT SEQ_SYS_ROLE.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO SYS_ROLE(ROLE_ID, ROLE_NAME, DESCRIPTION, UPDATE_BY)
        VALUES(#{roleId}, #{roleName}, #{description}, #{updateBy})
    </insert>

    <update id="update" parameterType="com.oracle.test.entity.SysRole">
        UPDATE SYS_ROLE SET
            ROLE_NAME = #{roleName},
            DESCRIPTION = #{description},
            UPDATE_TIME = SYSDATE,
            UPDATE_BY = #{updateBy}
        WHERE ROLE_ID = #{roleId}
    </update>

    <update id="logicDelete">
        UPDATE SYS_ROLE SET IS_DELETED = 1, UPDATE_TIME = SYSDATE WHERE ROLE_ID = #{roleId}
    </update>
</mapper>
